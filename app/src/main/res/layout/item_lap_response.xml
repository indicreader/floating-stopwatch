<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp"
    android:paddingHorizontal="10dp"
    android:layout_marginBottom="2dp"
    android:background="?attr/colorSurfaceContainer">

    <!-- Question Number Index -->
    <TextView
        android:id="@+id/tv_question_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="42dp"
        android:gravity="center"
        android:background="@drawable/badge_question_number"
        tools:text="Q01"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <!-- Option / Skip Badge -->
    <TextView
        android:id="@+id/tv_selected_option"
        android:layout_width="26dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:background="@drawable/bg_badge_option"
        tools:text="B"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Main Timing Block: Format "Q[n] • [Split Time] • (+/- vs target)" -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="6dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_split_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Q1 • 34s • (-11s)"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#E6ECE9"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cumulative_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Total: 01:14.2"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:textColor="#859990" />

    </LinearLayout>

    <!-- Color-coded Pacing Badge ([Fast], [On Pace], [Slow]) -->
    <TextView
        android:id="@+id/tv_pacing_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:background="@drawable/bg_badge_option"
        tools:text="Fast"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <!-- Spike tag for backward compatibility -->
    <TextView
        android:id="@+id/tv_spike_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Post-Pause Verification Actions -->
    <LinearLayout
        android:id="@+id/layout_verification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Correct Button -->
        <ImageButton
            android:id="@+id/btn_verify_correct"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check"
            android:contentDescription="Mark Correct"
            app:tint="?attr/colorSecondary" />

        <!-- Wrong Button -->
        <ImageButton
            android:id="@+id/btn_verify_wrong"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_cross"
            android:contentDescription="Mark Wrong"
            app:tint="?attr/colorOutline" />

        <!-- Skipped / Neutral Indicator -->
        <TextView
            android:id="@+id/tv_verify_skipped"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="—"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
