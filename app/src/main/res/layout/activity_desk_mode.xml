<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12161A">

    <LinearLayout
        android:id="@+id/layout_desk_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <!-- 1. Top Glanceable Status Bar -->
        <RelativeLayout
            android:id="@+id/layout_desk_top_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Prominent Close / Return to Overlay Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_desk_return_overlay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="✕"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#E6ECE9"
                    app:backgroundTint="#24342C"
                    app:cornerRadius="22dp"
                    app:strokeColor="#3A5245"
                    app:strokeWidth="1dp"
                    android:contentDescription="Return to Floating Overlay" />

                <!-- Mode & Drill Tag Container -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_desk_mode_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STOPWATCH"
                        android:letterSpacing="0.15"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#00E676" />

                    <TextView
                        android:id="@+id/btn_desk_drill_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Type - 1"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Active Question Pill -->
                <TextView
                    android:id="@+id/tv_desk_question_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_badge_option"
                    android:text="Q: 1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E6ECE9" />

                <!-- Average Pace Badge -->
                <TextView
                    android:id="@+id/tv_desk_avg_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_badge_skip"
                    android:text="Avg: --"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFAB00" />

                <!-- View Splits Button -->
                <ImageButton
                    android:id="@+id/btn_desk_splits"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:padding="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_format_list_bulleted"
                    android:contentDescription="View Splits History"
                    app:tint="#859990" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 2. Glanceable Hero Timer Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_desk_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#24342C"
            app:cardBackgroundColor="#15211B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tv_desk_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00.0"
                    android:fontFamily="monospace"
                    android:textSize="54sp"
                    android:textStyle="bold"
                    android:textColor="#E6ECE9"
                    android:letterSpacing="0.02"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_desk_split"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Active Q01 • Split: 00:00.0"
                    android:fontFamily="monospace"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#859990" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Oversized A/B/C/D Option Pad -->
        <LinearLayout
            android:id="@+id/layout_options_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_a"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginVertical="4dp"
                android:text="A"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1F2933"
                app:cornerRadius="16dp"
                app:strokeColor="#323F4B"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_b"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginVertical="4dp"
                android:text="B"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1F2933"
                app:cornerRadius="16dp"
                app:strokeColor="#323F4B"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_c"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginVertical="4dp"
                android:text="C"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1F2933"
                app:cornerRadius="16dp"
                app:strokeColor="#323F4B"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_option_d"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginVertical="4dp"
                android:text="D"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1F2933"
                app:cornerRadius="16dp"
                app:strokeColor="#323F4B"
                app:strokeWidth="1.5dp" />
        </LinearLayout>

        <!-- 4. Bottom Control Row -->
        <LinearLayout
            android:id="@+id/layout_desk_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- Review Flag Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_desk_review"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="★ Review"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#D1C4E9"
                app:backgroundTint="#311B92"
                app:cornerRadius="12dp"
                app:strokeColor="#512DA8"
                app:strokeWidth="1dp" />

            <!-- Skip Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_desk_skip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginEnd="6dp"
                android:text="Skip"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFCC80"
                app:backgroundTint="#E65100"
                app:cornerRadius="12dp"
                app:strokeColor="#FF6D00"
                app:strokeWidth="1dp" />

            <!-- Pause / Play Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_desk_play_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="⏸ Pause"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#263238"
                app:cornerRadius="12dp"
                app:strokeColor="#455A64"
                app:strokeWidth="1dp" />

            <!-- Reset Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_desk_reset"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:text="↺"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#EF9A9A"
                app:backgroundTint="#B71C1C"
                app:cornerRadius="12dp"
                app:strokeColor="#C62828"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Collapsible Splits History Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_laps_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="#323F4B"
        app:cardBackgroundColor="#1A2127"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Completed Question Splits"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btn_close_laps"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Close splits panel"
                    app:tint="#859990" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2E3D37"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_desk_laps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
