<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_floating_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#12161A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Accent Bar (eliminated per user request) -->
        <View
            android:id="@+id/view_top_accent_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_content_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <!-- 1. Drag Header & Window Controls -->
            <RelativeLayout
                android:id="@+id/layout_drag_header"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_window_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STOPWATCH"
                        android:letterSpacing="0.15"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#859990" />

                    <TextView
                        android:id="@+id/btn_countdown_preset_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/bg_badge_skip"
                        android:text="5m ▾"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFAB00"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Configurable Session Drill Tag (<Tag> - <Number>) -->
                    <TextView
                        android:id="@+id/btn_floating_drill_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/badge_question_number"
                        android:text="Type - 1"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Tap to cycle number, long press to cycle tag" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Settings Button (opens preferences from overlay) -->
                    <ImageButton
                        android:id="@+id/btn_floating_settings"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_settings"
                        android:contentDescription="Open Settings"
                        app:tint="#859990" />

                    <ImageView
                        android:id="@+id/iv_drag_handle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="2dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_drag_handle"
                        android:contentDescription="Drag to move"
                        app:tint="#859990" />

                    <ImageButton
                        android:id="@+id/btn_close"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="2dp"
                        android:padding="5dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:contentDescription="Close overlay"
                        app:tint="#859990" />

                </LinearLayout>

            </RelativeLayout>

            <!-- 2. Numerical Display matching original app style -->
            <TextView
                android:id="@+id/tv_timer_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="2dp"
                android:gravity="center"
                android:text="00:00:00.0"
                android:fontFamily="monospace"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#E6ECE9"
                android:includeFontPadding="false" />

            <!-- Subtext: "TIME REMAINING" for countdown or Date for Wall Clock -->
            <TextView
                android:id="@+id/tv_timer_subtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFD54F"
                android:visibility="gone"
                tools:text="TIME REMAINING" />

            <!-- 3. Active Question & Pacing Indicator Bar with Live Average Pace -->
            <LinearLayout
                android:id="@+id/layout_active_stats_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_active_pacing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    tools:text="Active Q01 • Split: 00:14.2"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#859990" />

            </LinearLayout>

            <!-- 4. Inline Starting Question Offset Prompt (Crash-Free, No External Dialog) -->
            <LinearLayout
                android:id="@+id/layout_inline_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:padding="6dp"
                android:background="@drawable/bg_badge_skip"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start from Q#:"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#E6ECE9" />

                <EditText
                    android:id="@+id/et_inline_question_offset"
                    android:layout_width="60dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_rounded_input_rect"
                    android:gravity="center"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:text="1"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:selectAllOnFocus="true"
                    android:maxLines="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_inline_start_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:text="Start ▶"
                    android:textSize="11sp"
                    android:backgroundTint="#00E676"
                    android:textColor="#0C1D17"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_inline_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:text="Cancel"
                    android:textSize="11sp"
                    android:backgroundTint="#2A3530"
                    android:textColor="#859990"
                    app:cornerRadius="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <!-- 5. Post-Pause Headline Accuracy & Timing Metrics Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_accuracy_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1D2924">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <!-- Metric 1: Accuracy % -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_metric_accuracy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="85%"
                                android:fontFamily="monospace"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#00E676" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Accuracy"
                                android:textSize="9sp"
                                android:textColor="#859990" />

                        </LinearLayout>

                        <!-- Metric 2: Live Average Time Per Question -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_metric_avg_pace"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="15s"
                                android:fontFamily="monospace"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#00E676" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg / Q"
                                android:textSize="9sp"
                                android:textColor="#859990" />

                        </LinearLayout>

                        <!-- Metric 3: Avg Correct Time -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_metric_avg_correct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="18.2s"
                                android:fontFamily="monospace"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#81C784" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg Correct"
                                android:textSize="9sp"
                                android:textColor="#859990" />

                        </LinearLayout>

                        <!-- Metric 4: Avg Incorrect Time -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_metric_avg_incorrect"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="36.5s"
                                android:fontFamily="monospace"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#FF5252" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg Wrong"
                                android:textSize="9sp"
                                android:textColor="#859990" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_metric_breakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        tools:text="12 Solved • 10 Correct • 2 Wrong • 1 Skipped"
                        android:textSize="10sp"
                        android:textColor="#A2B3AC" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 5b. Top Time-Sink Outliers ("Top Bottlenecks") -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_top_time_sinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFAB00"
                app:cardBackgroundColor="#221C12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOP TIME SINKS ⏳"
                            android:letterSpacing="0.08"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFB74D" />

                        <TextView
                            android:id="@+id/tv_review_needed_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFD54F"
                            tools:text="Review: 2 Qs" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_time_sinks_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Dedicated Dynamic Response Row (A, B, C, D, E, F, Skip) -->
            <include
                android:id="@+id/layout_option_buttons"
                layout="@layout/layout_option_buttons" />

            <!-- 7. Row 3: Compact 3-Button Action Controls Bar (Play/Pause, Reset, Logs/Expand) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="3">

                <!-- Button 1: Play / Pause -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/btn_play_pause"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_circle_primary"
                        android:src="@drawable/ic_play_arrow"
                        android:contentDescription="Start or Pause Stopwatch"
                        app:tint="#0C1D17" />
                </LinearLayout>

                <!-- Button 2: Reset -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/btn_reset"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_circle_secondary"
                        android:src="@drawable/ic_restart"
                        android:contentDescription="Reset Stopwatch"
                        app:tint="#E6ECE9" />
                </LinearLayout>

                <!-- Button 3: Logs / Expand -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_lap_count_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="0"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textColor="#859990" />

                    <!-- Stopwatch Mode: Laps Toggle -->
                    <ImageButton
                        android:id="@+id/btn_toggle_laps"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_circle_secondary"
                        android:src="@drawable/ic_calendar_laps"
                        android:contentDescription="Toggle Lap List Drawer"
                        app:tint="#E6ECE9" />

                    <!-- Countdown Mode: Preset Stepper Cycle Button -->
                    <ImageButton
                        android:id="@+id/btn_countdown_preset"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_circle_secondary"
                        android:src="@drawable/ic_hourglass"
                        android:contentDescription="Cycle Countdown Duration"
                        android:visibility="gone"
                        app:tint="#FFAB00" />

                    <!-- Wall Clock Mode: 12h/24h Toggle Button -->
                    <ImageButton
                        android:id="@+id/btn_wall_clock_toggle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_circle_secondary"
                        android:src="@drawable/ic_access_time"
                        android:contentDescription="Toggle 12h or 24h format"
                        android:visibility="gone"
                        app:tint="#FF5252" />
                </LinearLayout>

            </LinearLayout>

            <!-- 8. Expandable Lap / Response Drawer -->
            <LinearLayout
                android:id="@+id/layout_laps_drawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="4dp"
                    android:background="#2E3C36" />

                <!-- Lap List Header Labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:text="Q#"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textColor="#859990"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:gravity="center"
                        android:text="Ans"
                        android:textSize="11sp"
                        android:textColor="#859990"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Split / Total"
                        android:textSize="11sp"
                        android:textColor="#859990"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_header_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verify"
                        android:textSize="11sp"
                        android:textColor="#859990"
                        android:textStyle="bold" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_laps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:maxHeight="200dp"
                    tools:listitem="@layout/item_lap_response"
                    tools:itemCount="3" />

                <TextView
                    android:id="@+id/tv_no_laps"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="Tap an option (A, B, C, D, Skip) while timing"
                    android:textSize="11sp"
                    android:textColor="#859990" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom Resize Grip Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/iv_resize_handle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="2dp"
                android:src="@drawable/ic_resize_grip"
                android:contentDescription="Drag to resize window"
                app:tint="#859990" />

        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
