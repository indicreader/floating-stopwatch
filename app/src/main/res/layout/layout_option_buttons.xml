<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_options_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_option_a"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="2dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_option_b"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="2dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="B"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_option_c"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="2dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="C"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_option_d"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="2dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="D"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <!-- 5th Column Slot: Average Pace Readout Display -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_avg_pace_badge"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:clickable="false"
        android:focusable="false"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#2E3D37"
        app:cardBackgroundColor="#202A26">

        <TextView
            android:id="@+id/tv_avg_pace_badge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:maxLines="1"
            android:singleLine="true"
            android:clickable="false"
            android:focusable="false"
            android:text="Avg: --" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_option_e"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="2dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="E"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_option_f"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="2dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="F"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_option_skip"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:minWidth="0dp"
        android:paddingHorizontal="2dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Skip"
        android:textSize="12sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

</LinearLayout>
